diff --git a/frontend/src/components/monitorResourceSelect.css b/frontend/src/components/monitorResourceSelect.css
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/monitorResourceSelect.css
@@ -0,0 +1,183 @@
+.monitor-resource-select {
+  min-width: 0;
+  color: #4b5563;
+}
+.monitor-resource-label {
+  display: block;
+  margin-bottom: 5px;
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 18px;
+  color: #6b7280;
+}
+.monitor-resource-select .monitor-resource-trigger {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  height: 36px;
+  min-height: 36px;
+  padding: 0 10px;
+  border: 1px solid #d1d5db;
+  border-radius: 7px;
+  background: white;
+  font-size: 13px;
+  line-height: 20px;
+  text-align: left;
+  box-shadow: none;
+  transition:
+    border-color 150ms,
+    background-color 150ms;
+}
+.monitor-resource-select .monitor-resource-trigger:hover:not(:disabled) {
+  border-color: #93a4be;
+}
+.monitor-resource-select .monitor-resource-trigger:focus-visible {
+  outline: 2px solid #bfdbfe;
+  outline-offset: 1px;
+  border-color: #1e3a8a;
+}
+.monitor-resource-select .monitor-resource-trigger:disabled {
+  background: #f9fafb;
+  color: #9ca3af;
+  cursor: not-allowed;
+}
+.monitor-resource-trigger-content {
+  display: flex;
+  min-width: 0;
+  overflow: hidden;
+  flex: 1;
+  align-items: center;
+  gap: 6px;
+}
+.monitor-resource-trigger-name {
+  min-width: 0;
+  max-width: 100%;
+  flex: 0 0 auto;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  color: #111827;
+}
+.monitor-resource-placeholder {
+  color: #9ca3af;
+}
+.monitor-resource-trigger-tag {
+  min-width: 0;
+  max-width: 30%;
+  flex: 0 1 auto;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  border: 1px solid #dbeafe;
+  border-radius: 4px;
+  background: #eff6ff;
+  padding: 0 4px;
+  font-size: 11px;
+  line-height: 18px;
+  color: #1e3a8a;
+}
+.monitor-resource-menu {
+  margin-top: 5px;
+  padding: 4px;
+  border: 1px solid #dbe3ef;
+  border-radius: 8px;
+  background: white;
+}
+.monitor-resource-search {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 3px 8px;
+  border-radius: 5px;
+  background: #f3f4f6;
+}
+.monitor-resource-select .monitor-resource-search-input {
+  width: 100%;
+  min-width: 0;
+  height: 30px;
+  min-height: 30px;
+  border: 0;
+  border-radius: 0;
+  padding: 0;
+  background: transparent;
+  font-size: 13px;
+  color: #111827;
+  outline: none;
+  box-shadow: none;
+}
+.monitor-resource-options {
+  max-height: 256px;
+  overflow-y: auto;
+  overflow-x: hidden;
+  padding-top: 4px;
+}
+.monitor-resource-option {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  min-height: 36px;
+  padding: 7px 8px;
+  border-radius: 5px;
+  color: #374151;
+  text-align: left;
+}
+.monitor-resource-option:hover {
+  background: #f8fafc;
+}
+.monitor-resource-option[data-active='true'],
+.monitor-resource-option[aria-selected='true'] {
+  background: #eff6ff;
+  color: #1e3a8a;
+}
+.monitor-resource-option-content {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 4px 6px;
+  min-width: 0;
+  flex: 1;
+  font-size: 13px;
+  line-height: 19px;
+  overflow-wrap: anywhere;
+}
+.monitor-resource-option-name {
+  min-width: 0;
+  max-width: 100%;
+  font-weight: 500;
+}
+.monitor-resource-option-details {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 6px;
+  min-width: 0;
+  max-width: 100%;
+  font-size: 11px;
+  line-height: 18px;
+  color: #6b7280;
+}
+.monitor-resource-option-tag {
+  border-radius: 4px;
+  background: #eff6ff;
+  padding: 0 5px;
+  color: #1e3a8a;
+}
+@media (max-width: 767px) {
+  .monitor-resource-select .monitor-resource-trigger {
+    height: 44px;
+    min-height: 44px;
+    font-size: 16px;
+  }
+  .monitor-resource-select .monitor-resource-search-input {
+    min-height: 36px;
+    font-size: 16px;
+  }
+  .monitor-resource-option {
+    min-height: 44px;
+  }
+  .monitor-resource-option-content {
+    font-size: 14px;
+    line-height: 21px;
+  }
+}
diff --git a/frontend/src/components/monitorFilterLayout.css b/frontend/src/components/monitorFilterLayout.css
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/monitorFilterLayout.css
@@ -0,0 +1,126 @@
+/* 日志筛选：桌面全部条件在同一行，宽度不足仅滚动筛选区。 */
+.monitor-log-filter-form {
+  min-width: 0;
+}
+.monitor-log-filter-scroll {
+  min-width: 0;
+  max-width: 100%;
+  padding: 1px 1px 7px;
+}
+.monitor-log-filter-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  align-items: start;
+  gap: 12px;
+  min-width: 0;
+}
+.monitor-log-filter-grid > * {
+  min-width: 0;
+  grid-column: auto;
+  color: #6b7280;
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 18px;
+}
+.monitor-log-filter-grid .monitor-filter-label {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  height: 18px;
+  min-height: 18px;
+  margin-bottom: 5px;
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 18px;
+  white-space: nowrap;
+}
+.monitor-log-filter-grid .input,
+.monitor-log-filter-grid .monitor-log-range-trigger {
+  height: 44px;
+  min-height: 44px;
+  border-color: #d1d5db;
+  border-radius: 7px;
+  font-size: 16px;
+  font-weight: 400;
+  line-height: 20px;
+  box-shadow: none;
+}
+.monitor-log-filter-grid .input {
+  margin-top: 0;
+}
+.monitor-log-filter-grid .input:hover:not(:disabled) {
+  border-color: #93a4be;
+}
+.monitor-log-filter-grid .input:disabled {
+  background: #f9fafb;
+}
+.monitor-log-filter-grid .monitor-filter-account > div {
+  margin-top: 0;
+}
+.monitor-log-filter-grid .monitor-log-range-trigger {
+  display: flex;
+  width: 100%;
+  align-items: center;
+  gap: 7px;
+  padding: 0 10px;
+  color: #374151;
+  background: white;
+  text-align: left;
+}
+.monitor-log-range-summary {
+  min-width: 0;
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+}
+.monitor-filter-keyword-control {
+  position: relative;
+}
+.monitor-filter-keyword-icon {
+  position: absolute;
+  top: 50%;
+  left: 10px;
+  transform: translateY(-50%);
+  pointer-events: none;
+  color: #9ca3af;
+}
+.monitor-log-filter-grid .monitor-filter-keyword-control .input {
+  padding-left: 32px;
+}
+@media (min-width: 768px) {
+  .monitor-log-filter-scroll {
+    overflow-x: auto;
+    overscroll-behavior-x: contain;
+    scrollbar-width: thin;
+    scrollbar-color: #cbd5e1 transparent;
+  }
+  .monitor-log-filter-grid {
+    min-width: 1000px;
+    grid-template-columns:
+      minmax(184px, 1.05fr)
+      minmax(144px, 0.85fr)
+      minmax(144px, 0.85fr)
+      minmax(300px, 1.55fr)
+      minmax(160px, 1fr);
+    column-gap: 10px;
+  }
+  .monitor-log-filter-grid.monitor-log-filter-grid-legacy {
+    min-width: 1200px;
+    grid-template-columns:
+      minmax(184px, 1.05fr)
+      minmax(144px, 0.85fr)
+      minmax(140px, 0.85fr)
+      minmax(144px, 0.85fr)
+      minmax(124px, 0.75fr)
+      minmax(124px, 0.75fr)
+      minmax(160px, 1fr);
+  }
+  .monitor-log-filter-grid .input,
+  .monitor-log-filter-grid .monitor-log-range-trigger {
+    height: 36px;
+    min-height: 36px;
+    font-size: 13px;
+  }
+}

{
  "manifest_version": 3,
  "name": "Apple 订单辅助刷新",
  "version": "0.1.2",
  "description": "为管理员指定的订单创建临时页面，读取订单业务字段并交回订单管理系统。",
  "key": "",
  "permissions": ["debugger"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": [
      "https://apple.godp.me/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}

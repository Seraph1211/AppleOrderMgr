FROM apple-order-mgr-frontend:20261016-aos-tag-fallback
COPY --chown=node:node frontend/src/pages/ProxyOrders.jsx /app/src/pages/ProxyOrders.jsx
COPY --chown=node:node frontend/src/pages/proxyOrders/proxyOrders.css /app/src/pages/proxyOrders/proxyOrders.css
COPY --chown=node:node frontend/src/pages/proxyOrders/storeScope.js /app/src/pages/proxyOrders/storeScope.js
RUN npm run lint && npm run build

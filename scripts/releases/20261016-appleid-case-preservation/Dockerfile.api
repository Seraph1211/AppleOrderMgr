ARG BASE_API_IMAGE
FROM ${BASE_API_IMAGE}
COPY --chown=node:node src/controllers/appleIdController.js /app/src/controllers/appleIdController.js
COPY --chown=node:node src/services/importService.js /app/src/services/importService.js
COPY --chown=node:node src/services/profileImportService.js /app/src/services/profileImportService.js
COPY --chown=node:node src/services/proxyOrderService.js /app/src/services/proxyOrderService.js
COPY --chown=node:node src/utils/proxyOrderInput.js /app/src/utils/proxyOrderInput.js

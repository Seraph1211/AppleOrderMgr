FROM apple-order-mgr-frontend-builder:20261010-stock-followup-amd64
COPY src/pages/Stock.jsx /app/src/pages/Stock.jsx
COPY src/components/stock/stock.css src/components/stock/stockLifecycle.jsx src/components/stock/stockStatisticsCharts.jsx src/components/stock/stockFinancialDisplay.jsx /app/src/components/stock/
RUN npm run lint && npm run build

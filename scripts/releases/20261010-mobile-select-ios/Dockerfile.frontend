COPY src/components/TableHeaderHint.jsx /app/src/components/TableHeaderHint.jsx
COPY src/components/dateRangeFilter.jsx /app/src/components/dateRangeFilter.jsx
COPY src/components/inventory/InventoryCommon.jsx /app/src/components/inventory/InventoryCommon.jsx
COPY src/components/mobilePickerDialog.jsx /app/src/components/mobilePickerDialog.jsx
COPY src/components/orderPickupPhotos.jsx /app/src/components/orderPickupPhotos.jsx
COPY src/components/responsiveSelect.jsx /app/src/components/responsiveSelect.jsx
COPY src/components/stock/StockCommon.jsx /app/src/components/stock/StockCommon.jsx
COPY src/components/useModalScrollLock.js /app/src/components/useModalScrollLock.js

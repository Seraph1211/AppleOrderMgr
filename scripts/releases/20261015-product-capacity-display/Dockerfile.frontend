FROM apple-order-mgr-frontend:20261015-iphone-duo
COPY frontend/src/components/OrderDetailModal.jsx /app/src/components/OrderDetailModal.jsx
COPY frontend/src/components/ProductFilter.jsx /app/src/components/ProductFilter.jsx
COPY frontend/src/components/inventory/InventoryAnalysisView.jsx /app/src/components/inventory/InventoryAnalysisView.jsx
COPY frontend/src/components/inventory/InventoryCommon.jsx /app/src/components/inventory/InventoryCommon.jsx
COPY frontend/src/components/inventory/InventoryCoverageDialog.jsx /app/src/components/inventory/InventoryCoverageDialog.jsx
COPY frontend/src/components/inventory/InventoryScope.jsx /app/src/components/inventory/InventoryScope.jsx
COPY frontend/src/components/stock/ledgerEntryForm.jsx /app/src/components/stock/ledgerEntryForm.jsx
COPY frontend/src/components/stock/stockHelpers.js /app/src/components/stock/stockHelpers.js
COPY frontend/src/components/stock/stockLifecycle.jsx /app/src/components/stock/stockLifecycle.jsx
COPY frontend/src/pages/ChannelOrders.jsx /app/src/pages/ChannelOrders.jsx
COPY frontend/src/pages/InventoryMonitor.jsx /app/src/pages/InventoryMonitor.jsx
COPY frontend/src/pages/Iphone18QuotePricing.jsx /app/src/pages/Iphone18QuotePricing.jsx
COPY frontend/src/pages/OrderDetail.jsx /app/src/pages/OrderDetail.jsx
COPY frontend/src/pages/ProxyOrders.jsx /app/src/pages/ProxyOrders.jsx

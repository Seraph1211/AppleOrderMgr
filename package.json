{
  "name": "apple-order-manager",
  "version": "1.0.0",
  "description": "Apple订单管理系统 - 自动化邮件监听和订单同步",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/app.js",
    "start:order-mail-worker": "node src/workers/orderMailWorker.js",
    "start:email-worker": "node src/workers/emailWorker.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:browser:mail-contacts": "node scripts/testMailContactsBrowser.js",
    "test:browser:lifecycle": "node scripts/testLifecycleBrowser.js",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "docs:check": "npm run docs:check:links && npm run docs:check:schema",
    "security:verify-vendor": "node scripts/verifyVendor.js",
    "db:init": "node scripts/initDatabase.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:admin": "sequelize-cli db:seed --seed 20260719000001-create-default-admin.js",
    "db:seed:local-mock": "node scripts/generateLocalMockData.js",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "security:migrate": "node scripts/migrateSensitiveData.js",
    "docs:check:links": "node scripts/checkDocLinks.js",
    "docs:check:schema": "node scripts/check-doc-consistency.js",
    "test:browser:payments": "node scripts/testPaymentPagesBrowser.js",
    "test:browser:order-tags": "node scripts/testOrderTagAccessBrowser.js",
    "test:browser:tag-rules": "node scripts/testPaymentTagRulesBrowser.js",
    "test:browser:orders": "node scripts/testOrdersBrowser.js",
    "orders:restore-times": "node scripts/restoreOrderTimes.js",
    "collector:package": "node scripts/packageCollectorRelease.js",
    "test:browser:monitor": "node scripts/testServerMonitorBrowser.js",
    "test:browser:monitor-logs": "node scripts/testMonitorLogsBrowser.js",
    "orders:preview-product-filters": "node scripts/previewProductFilters.js",
    "test:browser:product-filters": "node scripts/testProductFiltersBrowser.js",
    "test:browser:quote-pricing": "node test/browser/quotePricingAcceptance.cjs",
    "start:wecom-worker": "node src/workers/wecomNotificationWorker.js",
    "inventory:validate": "node scripts/validateInventorySource.js",
    "inventory:preflight": "node scripts/measureInventoryCoverage.js",
    "start:inventory-worker": "node src/workers/inventoryWorker.js",
    "test:browser:inventory": "node scripts/testInventoryBrowser.js",
    "test:stock": "jest test/stockMoney.test.js test/stockRules.test.js test/stockCommand.test.js test/stockImport.test.js test/stockEvidence.test.js test/stockImportCleanup.test.js --runInBand",
    "test:stock:integration": "jest test/stock.integration.test.js test/stockImport.integration.test.js test/stockLegacy.integration.test.js test/stockLedger.integration.test.js --runInBand",
    "stock:repair-bridges": "node scripts/repairPickupStockBridge.js",
    "stock:cleanup-previews": "node scripts/cleanupStockImportPreviews.js",
    "test:stock:ledger": "jest test/stockLedger.integration.test.js --runInBand",
    "test:stock:ledger:migration": "jest test/stockLedgerMigration.integration.test.js --runInBand"
  },
  "keywords": [
    "apple",
    "order",
    "email",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@alicloud/ocr-api20210707": "3.1.3",
    "@alicloud/openapi-client": "0.4.15",
    "@alicloud/tea-util": "1.4.11",
    "ali-oss": "^6.23.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "https-proxy-agent": "^9.1.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "1.4.0",
    "mailauth": "^4.13.3",
    "mailparser": "^3.7.1",
    "multer": "2.3.0",
    "mysql2": "3.24.4",
    "node-cron": "^3.0.3",
    "node-imap": "^0.9.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "pngjs": "7.0.0",
    "sequelize": "^6.37.3",
    "socks-proxy-agent": "^10.1.0",
    "winston": "^3.13.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.2.5",
    "sequelize-cli": "^6.6.2"
  },
  "overrides": {
    "express": {
      "qs": "6.16.0"
    },
    "utf7": {
      "semver": "5.7.2"
    },
    "node-cron": {
      "uuid": "11.1.1"
    },
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}

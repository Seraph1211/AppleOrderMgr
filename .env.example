# 数据库配置
DB_NAME=apple_order_mgr
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
# 本地 Docker Compose 映射到宿主机的 PostgreSQL 端口
POSTGRES_HOST_PORT=5433
# 镜像可按本机缓存或团队基线覆盖；版本必须满足项目最低要求
POSTGRES_IMAGE=postgres:16-alpine
DEV_NODE_IMAGE=node:20-alpine
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# 敏感字段加密（用 `openssl rand -base64 32` 生成，并通过密钥系统注入）
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=v1
# 旧版本解密密钥，例如 {"v0":"base64-or-hex-key"}
FIELD_ENCRYPTION_KEYS_JSON={}
# 可选：独立的 32 字节盲索引密钥
FIELD_BLIND_INDEX_KEY=

# 邮件监听配置
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your_email@qq.com
IMAP_PASSWORD=your_imap_password
IMAP_TLS=true
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_MAILBOX=INBOX
# 生产必填；多个发件人使用逗号分隔
IMAP_ALLOWED_SENDERS=null-aos-helper@example.com
# 是否将已处理或已明确放弃的邮件标记为已读
IMAP_MARK_SEEN=true

# 代理配置
PROXY_API_URL=https://api.kdlapi.com/api/getproxy
PROXY_API_KEY=your_proxy_key_here
PROXY_ENABLED=false

# 爬虫配置
CRAWLER_DELAY_MIN=5000
CRAWLER_DELAY_MAX=10000
CRAWLER_MAX_RETRY=3
CRAWLER_TIMEOUT=30000
AUTO_ORDER_REFRESH_ENABLED=false
AUTO_ORDER_REFRESH_INTERVAL_MS=300000
CRAWLER_WIND_CONTROL_PAUSE_THRESHOLD=2

# Telegram 告警配置（仅使用占位符，生产环境从安全变量注入）
TELEGRAM_ENABLED=false
# 兼容旧变量名；新配置优先使用 TELEGRAM_ENABLED
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_PROXY_URL=
TELEGRAM_TIMEOUT=10000
# 心跳配置预留：当前读取配置，用于后续心跳发送和静默窗口控制
TELEGRAM_HEARTBEAT_ENABLED=false
TELEGRAM_HEARTBEAT_INTERVAL_MS=300000
TELEGRAM_HEARTBEAT_QUIET_START=
TELEGRAM_HEARTBEAT_QUIET_END=

# 服务配置
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_TO_FILES=false
LOG_DIR=./logs
RUN_WORKERS_IN_API=false
# 仅本地 development + admin 生效；生产环境即使误设也不会返回明文
ALLOW_LOCAL_SENSITIVE_DISPLAY=false
# 宿主机 Nginx 反向代理单实例 API 时设为 1
TRUST_PROXY=
FRONTEND_URL=http://localhost:5173

# JWT 认证配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# 登录安全配置
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
# 首次管理员密码至少 8 位；首次登录后仍会强制修改
ADMIN_INITIAL_PASSWORD=

# Apple订单相关
APPLE_ORDER_BASE_URL=https://www.apple.com.cn/xc/cn/vieworder

# 测试配置（用于 test_crawler.js）
ALLOW_LOCAL_MOCK_DATA=false
TEST_ORDER_NUMBER=W1234567890
TEST_APPLE_ID=test@example.com

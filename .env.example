# 数据库配置
DB_NAME=apple_order_mgr
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
# 本地 Docker Compose 映射到宿主机的 PostgreSQL 端口
POSTGRES_HOST_PORT=5433
# 镜像可按本机缓存或团队基线覆盖；版本必须满足项目最低要求
POSTGRES_IMAGE=postgres:16-alpine
DEV_NODE_IMAGE=node:20-alpine
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# 敏感字段加密（用 `openssl rand -base64 32` 生成，并通过密钥系统注入）
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=v1
# 旧版本解密密钥，例如 {"v0":"base64-or-hex-key"}
FIELD_ENCRYPTION_KEYS_JSON={}
# 可选：独立的 32 字节盲索引密钥
FIELD_BLIND_INDEX_KEY=

# 邮件监听配置
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your_email@qq.com
IMAP_PASSWORD=your_imap_password
IMAP_TLS=true
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_MAILBOX=INBOX
# 可选；完整地址精确白名单，多个值使用逗号分隔
IMAP_ALLOWED_SENDERS=
# 可选；域名精确白名单，例如 lanu.cn；不匹配子域名或相似后缀
IMAP_ALLOWED_SENDER_DOMAINS=
# 是否将已处理或已明确放弃的邮件标记为已读
IMAP_MARK_SEEN=true

# 服务器监控告警发信；留空时复用 IMAP_USER／IMAP_PASSWORD，并从 imap.* 推导 smtp.*。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram 告警配置（仅使用占位符，生产环境从安全变量注入）
TELEGRAM_ENABLED=false
# 兼容旧变量名；新配置优先使用 TELEGRAM_ENABLED
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_PROXY_URL=
TELEGRAM_TIMEOUT=10000
# 心跳配置预留：当前读取配置，用于后续心跳发送和静默窗口控制
TELEGRAM_HEARTBEAT_ENABLED=false
TELEGRAM_HEARTBEAT_INTERVAL_MS=300000
TELEGRAM_HEARTBEAT_QUIET_START=
TELEGRAM_HEARTBEAT_QUIET_END=

# 服务配置
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_TO_FILES=false
LOG_DIR=./logs
RUN_WORKERS_IN_API=false
# 仅本地 development + admin 生效；生产环境即使误设也不会返回明文
ALLOW_LOCAL_SENSITIVE_DISPLAY=false
# 宿主机 Nginx 反向代理单实例 API 时设为 1
TRUST_PROXY=
FRONTEND_URL=http://localhost:5173
# Windows 采集器填写的公网 HTTPS 根地址；临时 Quick Tunnel 重启后需更新
AOS_COLLECTOR_PUBLIC_URL=

# 取货与结款凭证存储（私有阿里云 OSS Bucket）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# JWT 认证配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# 登录安全配置
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
# 首次管理员密码至少 8 位；首次登录后仍会强制修改
ADMIN_INITIAL_PASSWORD=

# Apple订单相关
APPLE_ORDER_BASE_URL=https://www.apple.com.cn/xc/cn/vieworder

# 测试配置（用于 test_crawler.js）
ALLOW_LOCAL_MOCK_DATA=false
TEST_ORDER_NUMBER=W1234567890
TEST_APPLE_ID=test@example.com

# 身份核验（已有阿里云云市场 AppCode，仅后端加载）
IDENTITY_VERIFICATION_ENABLED=false
IDENTITY_APPCODE=
# 与上项二选一；本地 Compose 挂载 .secrets 为 /run/secrets（只读）
IDENTITY_APPCODE_FILE=

# Windows 采集器签名更新；发布目录只读挂载，公钥与引导包一致。未设置时禁用更新发布。
COLLECTOR_RELEASE_DIR=
COLLECTOR_UPDATE_PUBLIC_KEY_FILE=

# 订单列表关联邮件（独立于建单邮箱，默认不连接真实邮箱）
ORDER_MAIL_ENABLED=false
ORDER_MAIL_IMAP_HOST=mail5.lanu.cn
ORDER_MAIL_IMAP_PORT=993
ORDER_MAIL_SMTP_HOST=mail5.lanu.cn
ORDER_MAIL_SMTP_PORT=465
ORDER_MAIL_USER=
ORDER_MAIL_PASSWORD=
# 推荐配置容器内只读凭据文件路径；配置时优先于 PASSWORD
ORDER_MAIL_PASSWORD_FILE=
ORDER_MAIL_MAILBOX=INBOX
ORDER_MAIL_LOOKBACK_DAYS=30
ORDER_MAIL_SENDER_DOMAINS=apple.com,apple.com.cn
# 生命周期邮件先解析并留证；订单应用与付款任务联动必须分别显式启用。
ORDER_MAIL_LIFECYCLE_PARSE_ENABLED=true
ORDER_MAIL_LIFECYCLE_APPLY_ENABLED=false
ORDER_MAIL_PAYMENT_TASK_APPLY_ENABLED=false

# 取货图片识别：独立 RAM 身份仅授予 ocr:RecognizeAdvanced，严禁前端配置密钥
PICKUP_OCR_ENABLED=false
PICKUP_OCR_ACCESS_KEY_ID=
PICKUP_OCR_ACCESS_KEY_SECRET=
PICKUP_OCR_MONTHLY_LIMIT=1000

# Apple 公开报价只读来源库（当前仅 iPhone 18；使用仅 SELECT 权限的独立 MySQL 账号）
QUOTE_SOURCE_DB_HOST=
QUOTE_SOURCE_DB_PORT=3306
QUOTE_SOURCE_DB_USER=
QUOTE_SOURCE_DB_PASSWORD=
QUOTE_SOURCE_DB_NAME=ppspider_data
QUOTE_SOURCE_DB_POOL_MAX=3
QUOTE_SOURCE_DB_CONNECT_TIMEOUT=5000
QUOTE_SOURCE_STALE_MINUTES=5
